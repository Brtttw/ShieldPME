# true  = usa os dados de src/data (site funciona sem backend)
# false = chama a API do Spring Boot (veja src/services)
VITE_USE_MOCK=true

# Base da API. Com o proxy do Vite (dev) ou com o front servido pelo próprio Spring Boot, use /api
VITE_API_URL=/api

# Client ID público do Google Sign-In
VITE_GOOGLE_CLIENT_ID=171434987194-mlavqfsd9qmsr4pduhcmknholhul2e25.apps.googleusercontent.com
